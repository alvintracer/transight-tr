{
  "name": "transight-tr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TravelSafer Travel Rule solution built on Supabase",
  "scripts": {
    "dev": "supabase start",
    "dev:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration up",
    "functions:serve": "supabase functions serve",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "sdk:build": "tsc -p packages/bonanza-ttr-sdk/tsconfig.json",
    "sdk:typecheck": "tsc -p packages/bonanza-ttr-sdk/tsconfig.json --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "ed2curve": "^0.3.0",
    "libsodium-wrappers": "^0.7.15",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^20.17.12",
    "@types/uuid": "^9.0.8",
    "supabase": ">=1.0.0",
    "typescript": "^5.7.3",
    "vitepress": "^1.6.4",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
