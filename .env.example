# ===========================================
# TranSight TR — Environment Variables
# ===========================================

# Supabase (Local: supabase start 후 자동 표시됨)
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=

# TranSight Hub 키 (Ed25519)
TRANSIGHT_PRIVATE_KEY=           # Base64 encoded Ed25519 signing key
TRANSIGHT_PUBLIC_KEY=            # Base64 encoded Ed25519 verify key
TRANSIGHT_VASP_ENTITY_ID=transight-hub

# CODE VASP API (개발 환경)
CODE_API_BASE_URL=https://trapi-dev.codevasp.com
CODE_API_VERSION=v1

# KYT 연동 (기존 TranSight KYT)
KYT_API_BASE_URL=
KYT_API_KEY=

# Sumsub Travel Rule (TRUST 프로토콜)
SUMSUB_APP_TOKEN=                # Dashboard → API → App Token
SUMSUB_SECRET_KEY=               # Dashboard → API → Secret Key
SUMSUB_API_BASE_URL=https://api.sumsub.com
SUMSUB_APPLICANT_ID=             # Hub의 Sumsub Applicant ID

# 서버 설정
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
