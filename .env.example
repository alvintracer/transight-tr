# ===========================================
# TranSight TR — Environment Variables
# ===========================================

# Supabase (Local: supabase start 후 자동 표시됨)
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=

# TranSight Hub 키 (Ed25519)
TRANSIGHT_PRIVATE_KEY=           # Base64 encoded Ed25519 signing key
TRANSIGHT_PUBLIC_KEY=            # Base64 encoded Ed25519 verify key
TRANSIGHT_VASP_ENTITY_ID=transight-hub

# CODE VASP API (개발 환경)
CODE_API_BASE_URL=https://trapi-dev.codevasp.com
CODE_API_VERSION=v1

# KYT 연동 (TranSight 내부 KYT — Atomic Gate)
KYT_API_BASE_URL=                # TranSight KYT API (예: https://api.transight.io)
KYT_API_KEY=                     # KYT API Key (HMAC 서명용)
KYT_BLOCK_THRESHOLD=80           # 이 점수 이상이면 BLOCK (0~100)
KYT_WARN_THRESHOLD=50            # 이 점수 이상이면 WARN (로그만, TR 진행)
KYT_DISABLED=false               # true면 KYT 검사 건너뜀 (테스트용)
KYT_TIMEOUT_MS=5000              # KYT API 타임아웃 (ms)

# Sumsub Travel Rule (TRUST 프로토콜)
SUMSUB_APP_TOKEN=                # Dashboard → API → App Token
SUMSUB_SECRET_KEY=               # Dashboard → API → Secret Key
SUMSUB_API_BASE_URL=https://api.sumsub.com
SUMSUB_APPLICANT_ID=             # Hub의 Sumsub Applicant ID

# GTR (Global Travel Rule — PII Verification)
GTR_API_BASE_URL=https://api.globaltravelrule.com   # GTR API Base URL
GTR_API_KEY=                     # GTR Dashboard → API Key
GTR_PUBLIC_KEY=                  # TTR Hub Curve25519 공개키 (GTR Dashboard에 등록한 키)
GTR_PRIVATE_KEY=                 # TTR Hub Curve25519 비밀키 (Payload 암호화용)

# 서버 설정
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
